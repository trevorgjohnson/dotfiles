# HINT: Use `swaymsg -t get_outputs` to get the outputs
output * bg $(find /home/trevo/Pictures/wallpapers/ -type f | shuf -n1) fill

input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    scroll_factor 0.5
    middle_emulation enabled
}

# Idle management: dim (60s) -> screen off (65s) -> suspend (300s)
exec swayidle -w \
    timeout 60 'brightnessctl set 0%' resume 'brightnessctl set 100%' \
    timeout 65 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    timeout 300 'systemctl suspend' \
    before-sleep 'swaylock -f'
