#!/bin/bash

# This script concatenates a list of input clips.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: concat <clip_loc> [output.mp4] [-p fast|compress|raw] [extra_ffmpeg_opts]

clip_loc    - Directory containing clips to concatenate in lexicographical order.
output.mp4  - Output video name (defaults to output.mp4).

Presets (-p):
  fast      - Instant video copy with re-encoded audio sync fix (default)
  compress  - H.264 CRF 30 compression with audio sync fix
  raw       - No default flags; allows setting all ffmpeg opts explicitly

Extra opts:
  Any additional ffmpeg options are appended to the chosen preset.
EOF
  exit 1
}

if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
  usage
fi

CLIP_LOC=""
OUTPUT_NAME=""
PRESET="fast"
EXTRA_OPTS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      ;;
    -p|--preset)
      if [[ -z "${2:-}" ]]; then
        echo "Error: -p requires a preset name (fast, compress, raw)" >&2
        exit 1
      fi
      PRESET="$2"
      shift 2
      ;;
    *)
      if [[ -z "$CLIP_LOC" ]]; then
        CLIP_LOC="$1"
      elif [[ -z "$OUTPUT_NAME" ]]; then
        OUTPUT_NAME="$1"
      else
        EXTRA_OPTS+=("$1")
      fi
      shift
      ;;
  esac
done

if [[ -z "$CLIP_LOC" || ! -d "$CLIP_LOC" ]]; then
  echo "Error: '$CLIP_LOC' is not a valid directory." >&2
  usage
fi

CLIP_LOC=$(realpath -- "$CLIP_LOC")

if [[ -z "$OUTPUT_NAME" ]]; then
  OUTPUT_NAME="output.mp4"
fi

case "$PRESET" in
  fast)
    PRESET_OPTS=("-c:v" "copy" "-c:a" "aac" "-b:a" "192k" "-af" "aresample=async=1:first_pts=0" "-movflags" "+faststart")
    ;;
  compress)
    PRESET_OPTS=("-c:v" "libx264" "-crf" "30" "-threads" "0" "-c:a" "aac" "-b:a" "128k" "-af" "aresample=async=1:first_pts=0" "-movflags" "+faststart")
    ;;
  raw)
    PRESET_OPTS=()
    ;;
  *)
    echo "Error: Unknown preset '$PRESET'. Available: fast, compress, raw" >&2
    exit 1
    ;;
esac

FINAL_OPTS=("${PRESET_OPTS[@]}" "${EXTRA_OPTS[@]}")

if [[ -e "$OUTPUT_NAME" ]]; then
  output_dir=$(dirname -- "$OUTPUT_NAME")
  output_file=$(basename -- "$OUTPUT_NAME")
  output_stem=${output_file%.*}
  output_ext=

  if [[ $output_file == *.* && $output_file != .* ]]; then
    output_ext=.${output_file##*.}
  fi

  output_candidate="$output_stem"
  while [[ -e "$output_dir/$output_candidate$output_ext" ]]; do
    output_candidate="${output_candidate}new"
  done

  OUTPUT_NAME="$output_dir/$output_candidate$output_ext"
fi

shopt -s nullglob
CLIPS=("$CLIP_LOC"/*)

if (( ${#CLIPS[@]} == 0 )); then
  echo "No clips found in $CLIP_LOC" >&2
  exit 1
fi

ffmpeg -f concat -safe 0 -i <(for f in "${CLIPS[@]}"; do printf "file '%s'\n" "$f"; done) "${FINAL_OPTS[@]}" "$OUTPUT_NAME"
echo "Saved to $OUTPUT_NAME"
