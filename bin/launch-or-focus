#!/bin/bash

# Launch or focus on a given command identified by the passed in window-pattern.
# Matches the pattern (word-boundary, case-insensitive) against each window's Wayland app_id, XWayland class, or title.
# Use by some default bindings, like the one for Spotify, to ensure there is only one instance of the app open.

if (($# == 0)); then
  echo "Usage: launch-or-focus [window-pattern] [launch-command]"
  exit 1
fi

WINDOW_PATTERN="$1"
LAUNCH_COMMAND="${2:-$WINDOW_PATTERN}"

# Recurse the sway tree (tiled + floating), keep only real windows, and match against app_id / XWayland class / name.
WINDOW_ID=$(swaymsg -t get_tree | jq -r --arg p "$WINDOW_PATTERN" '
  [recurse((.nodes // []) + (.floating_nodes // []) | .[])]
  | map(select(.type == "con" and (.app_id != null or .window != null)))
  | .[]
  | select(
      ((.app_id // "") | test("\\b" + $p + "\\b"; "i"))
      or ((.window_properties.class // "") | test("\\b" + $p + "\\b"; "i"))
      or ((.name // "") | test("\\b" + $p + "\\b"; "i"))
    )
  | .id' | head -n1)

if [[ -n $WINDOW_ID ]]; then
  swaymsg "[con_id=$WINDOW_ID] focus"
else
  eval exec setsid $LAUNCH_COMMAND
fi
